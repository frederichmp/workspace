# ==============================================================================
# COFRE DE CREDENCIAIS - ORACLE DATABASE (Modo Thin)
# ==============================================================================
ORACLE_DSN=192.168.1.100:1521/PRDMV

# Papéis segregados para execução de scripts homologados (Leitura vs Mutação)
ORACLE_USER_READ=usuario_readonly
ORACLE_PASSWORD_READ=senha_readonly
ORACLE_USER_MUT=usuario_mutacao
ORACLE_PASSWORD_MUT=senha_mutacao
ORACLE_CALL_TIMEOUT_MS=30000

# Papéis segregados para diagnóstico e encerramento de sessão
ORACLE_USER_DIAG=startup_diag
ORACLE_PASSWORD_DIAG=senha_diag
ORACLE_USER_KILL=startup_kill
ORACLE_PASSWORD_KILL=senha_kill

# ==============================================================================
# CONFIGURAÇÕES DE LLM / SEGUNDO CÉREBRO (GEMINI API & OLLAMA LOCAL)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=qwen2.5:7b

# ==============================================================================
# CONFIGURAÇÕES DE ALERTA (SMTP GMAIL - HITL)
# ==============================================================================
EMAIL_REMETENTE=seu_email@gmail.com
EMAIL_SENHA_APP=sua_senha_de_aplicativo_de_16_digitos
EMAIL_DESTINATARIO=equipe_dba@suaempresa.com.br

# ==============================================================================
# CONFIGURAÇÕES GERAIS DO AGENTE
# ==============================================================================
AGENT_NAME=PersonalAgentDBA
LOG_LEVEL=INFO

# Diretório do log de aprovações de kill (fora de pasta sincronizada). Padrão: C:\AgentDBA\logs
AGENTDBA_LOG_DIR=C:\AgentDBA\logs
