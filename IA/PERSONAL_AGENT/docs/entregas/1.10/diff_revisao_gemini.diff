+def _snapshot_logs_reais():
+    """(existe, tamanho, mtime_ns) por stat; o conteúdo nunca é lido."""
+    out = {}
+    for p in LOGS_REAIS:
+        try:
+            st = p.stat()
+            out[str(p)] = (True, st.st_size, st.st_mtime_ns)
+        except FileNotFoundError:
+            out[str(p)] = (False, None, None)
+    return out
