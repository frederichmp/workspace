+    def json_devolvido_ao_llm(self):
+        """Conteúdo (JSON) da mensagem `tool` vista pelo LLM na chamada de fechamento (a última)."""
+        tools = [m for m in self.mensagens_llm[-1] if m.get("role") == "tool"]
+        return json.loads(tools[-1]["content"])
